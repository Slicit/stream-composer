# Stream Composer — Go/Rails/React stack configuration.
#
# Copy to .env and fill in the values marked CHANGE_ME. There is no
# install.sh for this stack yet (see the LOGBOOK entry this file is
# referenced from) — everything here is set by hand for now.

# Which compose files to use.
COMPOSE_FILE=docker-compose.go-rails-react.yml:docker-compose.go-rails-react.tls.yml

COMPOSE_PROJECT_NAME=stream-composer

# ---------------------------------------------------------------- versions
MEDIAMTX_VERSION=1.19.1
TRAEFIK_VERSION=v3.7

# ------------------------------------------------------------------- images
# Left unset here on purpose: with no RAILS_IMAGE/DATAPLANE_IMAGE, the
# rails/dataplane services fall back to their compose-file defaults
# (sc-rails:latest, sc-dataplane:latest) and `docker compose up --build`
# builds them locally from source — the dev workflow this file otherwise
# documents. To pull pre-built images instead (seconds, not a ~10 minute
# build — see .github/workflows/build-go-rails-react-images.yml), set:
#
#   RAILS_IMAGE=ghcr.io/slicit/stream-composer-rails
#   RAILS_TAG=beta          # or a pinned beta-<short-sha> from a run
#   DATAPLANE_IMAGE=ghcr.io/slicit/stream-composer-dataplane
#   DATAPLANE_TAG=beta
#
# install-go-rails-react.sh / update-go-rails-react.sh write these for
# you and never build locally; CHANNEL is what they remember choosing
# (beta | stable — stable does not exist yet, see the images.yml comment)
# so a bare re-run doesn't silently change channel.
CHANNEL=
RAILS_IMAGE=
RAILS_TAG=
DATAPLANE_IMAGE=
DATAPLANE_TAG=

# ------------------------------------------------------------------ secrets
# Generate with:  openssl rand -hex 32
INTERNAL_SECRET=CHANGE_ME_32_RANDOM_BYTES
INTERNAL_API_TOKEN=CHANGE_ME_32_RANDOM_BYTES
POSTGRES_PASSWORD=CHANGE_ME_32_RANDOM_BYTES
#
# Rails' own secret — never generated here. Copy the value from
# rails-service/config/master.key (created once, locally, the first time
# anyone ran `bin/rails` against this checkout — see that file's own
# .gitignore entry; it is never committed). Every deployment of this same
# Rails app must use the same key, since it decrypts config/credentials.yml.enc.
RAILS_MASTER_KEY=CHANGE_ME_see_rails-service/config/master.key

# ------------------------------------------------------------- first admin
# Used only when the database is empty. If left blank a random password is
# printed to the container log on first start.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --------------------------------------------------------------- addressing
# Hostname or IP that viewers and OBS will use, and Traefik's Host() rule.
PUBLIC_HOST=
DOMAIN=
ACME_EMAIL=

# ------------------------------------------------------------------- ports
RTMP_PORT=1935
RTMPS_PORT=1936
SRT_PORT=8890
WEBRTC_UDP_PORT=8189

# ----------------------------------------------------------------- logging
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# ---------------------------------------------------------------- encoding
# Server-side ffmpeg composition is out of scope for this stack (browser
# composition only — see LOGBOOK/features/feat-migration-go-dataplane.md's
# "browser composition, not server-side ffmpeg composition" decision), so
# ENCODER is currently unused by the Go data plane. Left here so the two
# stacks' .env files stay easy to diff.
ENCODER=

TZ=UTC
