# Stream Composer — Go/Rails/React stack configuration.
#
# Copy to .env and fill in the values marked CHANGE_ME. For a real
# deployment, prefer install-go-rails-react.sh — it writes this file for
# you. This one is for the dev/manual-setup path.

# Which compose files to use.
COMPOSE_FILE=docker-compose.go-rails-react.yml:docker-compose.go-rails-react.tls.yml

COMPOSE_PROJECT_NAME=stream-composer

# ---------------------------------------------------------------- versions
MEDIAMTX_VERSION=1.19.1
TRAEFIK_VERSION=v3.7

# ------------------------------------------------------------------- images
# Left unset here on purpose: with no RAILS_IMAGE/DATAPLANE_IMAGE, the
# rails/dataplane services fall back to their compose-file defaults
# (sc-rails:latest, sc-dataplane:latest) and `docker compose up --build`
# builds them locally from source — the dev workflow this file otherwise
# documents. To pull pre-built images instead (seconds, not a ~10 minute
# build — see .github/workflows/build-go-rails-react-images.yml), set:
#
#   RAILS_IMAGE=ghcr.io/slicit/stream-composer-rails
#   RAILS_TAG=stable        # or beta, or a pinned <channel>-<short-sha>
#   DATAPLANE_IMAGE=ghcr.io/slicit/stream-composer-dataplane
#   DATAPLANE_TAG=stable
#   COMPOSITOR_IMAGE=ghcr.io/slicit/stream-composer-compositor
#   COMPOSITOR_TAG=stable
#
# install-go-rails-react.sh / update-go-rails-react.sh write these for
# you and never build locally; CHANNEL is what they remember choosing
# (beta | stable — stable tracks main, beta tracks migration/go-rails-react)
# so a bare re-run doesn't silently change channel.
CHANNEL=
RAILS_IMAGE=
RAILS_TAG=
DATAPLANE_IMAGE=
DATAPLANE_TAG=
COMPOSITOR_IMAGE=
COMPOSITOR_TAG=

# ------------------------------------------------------------------ secrets
# Generate with:  openssl rand -hex 32
INTERNAL_SECRET=CHANGE_ME_32_RANDOM_BYTES
INTERNAL_API_TOKEN=CHANGE_ME_32_RANDOM_BYTES
POSTGRES_PASSWORD=CHANGE_ME_32_RANDOM_BYTES
#
# Rails' own secret — never generated here. Copy the value from
# rails-service/config/master.key (created once, locally, the first time
# anyone ran `bin/rails` against this checkout — see that file's own
# .gitignore entry; it is never committed). Every deployment of this same
# Rails app must use the same key, since it decrypts config/credentials.yml.enc.
RAILS_MASTER_KEY=CHANGE_ME_see_rails-service/config/master.key

# ------------------------------------------------------------- first admin
# Used only when the database is empty. If left blank a random password is
# printed to the container log on first start.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --------------------------------------------------------------- addressing
# Hostname or IP that viewers and OBS will use, and Traefik's Host() rule.
PUBLIC_HOST=
DOMAIN=
ACME_EMAIL=

# ------------------------------------------------------------------- email
# Self-registration confirmation emails — generic SMTP, wired through
# ActionMailer's smtp_settings. Leave blank in dev/test (and in
# production, if you don't want this yet); ActionMailer falls back to
# Rails' :test delivery method (nothing is actually sent) so the
# registration flow works out of the box with nothing configured.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=
MAIL_FROM=no-reply@example.com

# ------------------------------------------------------------------- ports
RTMP_PORT=1935
RTMPS_PORT=1936
SRT_PORT=8890
WEBRTC_UDP_PORT=8189

# ----------------------------------------------------------------- logging
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# ---------------------------------------------------------------- encoding
# Watching on this site is still 100% browser composition — ENCODER here
# is unused by dataplane itself. Server-side ffmpeg composition exists
# only as the opt-in `compositor` service, for restreaming a channel's
# composed picture out to YouTube/TikTok/etc. — see
# go-service/internal/compositor. Its own encoder choice
# (auto|software|vaapi|qsv) is per-channel-composition config in the
# admin/self-service UI, not an env var; MAX_COMPOSITOR_JOBS below is
# its concurrency cap, and a device passthrough for hardware encoding is
# commented out on the `compositor` service in
# docker-compose.go-rails-react.yml.
ENCODER=
MAX_COMPOSITOR_JOBS=4

TZ=UTC
