# Stream Composer configuration.
#
# `install.sh` generates this file for you with fresh secrets. Copy it by hand
# only if you know what you are doing — the two secrets below must be random.

# Which compose files to use. The installer sets this; leave it alone unless
# you are switching between plain HTTP and TLS.
#   docker-compose.yml:docker-compose.local.yml   plain HTTP on HTTP_PORT
#   docker-compose.yml:docker-compose.tls.yml     Traefik + Let's Encrypt
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
#
# Stuck on the old standalone docker-compose (v1)? It cannot read the files
# above. Use the generated fallback instead — same stack, 3.7 schema:
#   COMPOSE_FILE=docker-compose.v1.yml:docker-compose.v1.local.yml
#   COMPOSE_FILE=docker-compose.v1.yml:docker-compose.v1.tls.yml
# The installer picks this for you when it finds only v1.

# Names containers and volumes. Set explicitly because Compose v1 has no
# top-level `name:` key, so this is what keeps both versions in agreement.
COMPOSE_PROJECT_NAME=stream-composer

# ---------------------------------------------------------------- versions
COMPOSER_IMAGE=ghcr.io/slicit/stream-composer
COMPOSER_TAG=latest
MEDIAMTX_VERSION=1.19.1
TRAEFIK_VERSION=v3.7

# ------------------------------------------------------------------ secrets
# Generate with:  openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_32_RANDOM_BYTES
INTERNAL_SECRET=CHANGE_ME_32_RANDOM_BYTES

# ------------------------------------------------------------- first admin
# Used only when the database is empty. If left blank a random password is
# printed to the container log on first start.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --------------------------------------------------------------- addressing
# Hostname or IP that viewers and OBS will use. Required for WebRTC to work
# from anywhere other than the server itself.
PUBLIC_HOST=
# Only needed with the TLS overlay:
DOMAIN=
ACME_EMAIL=

# ------------------------------------------------------------------- ports
HTTP_PORT=8080
RTMP_PORT=1935
RTMPS_PORT=1936
SRT_PORT=8890
WEBRTC_UDP_PORT=8189

# ----------------------------------------------------------------- logging
# Application log files inside the container volume.
LOG_LEVEL=info
LOG_MAX_SIZE_MB=20
LOG_MAX_FILES=5
# Docker's own capture of container stdout.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# ---------------------------------------------------------------- encoding
# Leave empty for automatic detection (hardware if present, otherwise libx264).
# Force a choice with: x264 | vaapi | nvenc | qsv
ENCODER=

TZ=UTC
