# Dev/test image for the migration stack (docker-compose.migration.yml).
# Not for production — see Dockerfile (Kamal-oriented) for that, once this
# service is ready to actually deploy.
FROM ruby:3.3-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential libpq-dev libyaml-dev postgresql-client git && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails

COPY Gemfile Gemfile.lock* ./
RUN bundle install

COPY . .

EXPOSE 3000
# See Dockerfile's own comment: db:prepare alone only seeds a brand-new
# database, so this also runs db:seed on every boot (safe to rerun, see
# db/seeds.rb) to keep dev containers in sync with prod's behavior.
CMD ["sh", "-c", "bin/rails db:prepare && bin/rails db:seed && bin/rails server -b 0.0.0.0"]
